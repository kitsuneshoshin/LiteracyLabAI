{
  "rewrites": [
    {
      "source": "/unsubscribe",
      "destination": "/unsubscribe.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/c/:token",
      "destination": "/share.html"
    }
  ],
  "functions": {
    "api/email.js": {
      "maxDuration": 60
    },
    "api/submit.js": {
      "maxDuration": 60
    },
    "api/reading-passage.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/email?action=cron",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/email?action=qa",
      "schedule": "0 21 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
