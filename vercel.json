{
  "rewrites": [
    {
      "source": "/unsubscribe",
      "destination": "/unsubscribe.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    }
  ],
  "functions": {
    "api/email.js": {
      "maxDuration": 60
    },
    "api/submit.js": {
      "maxDuration": 60
    },
    "api/reading-passage.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/email?action=cron",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/email?action=qa",
      "schedule": "0 21 * * 0"
    }
  ]
}
