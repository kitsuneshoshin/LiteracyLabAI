{
  "rewrites": [
    {
      "source": "/unsubscribe",
      "destination": "/unsubscribe.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    }
  ],
  "functions": {
    "api/email.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/email?action=cron",
      "schedule": "0 22 * * *"
    }
  ]
}
